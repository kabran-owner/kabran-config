{
  "name": "@kabran-tecnologia/kabran-config",
  "version": "1.9.0",
  "description": "Shared quality configurations, enforcement scripts, and CI/CD tooling for Kabran projects",
  "author": "Kabran",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kabran-setup": "src/scripts/setup.mjs",
    "kabran-ci": "src/scripts/ci/ci-runner.sh",
    "kabran-pr-comment": "src/scripts/pr-quality-comment.mjs",
    "kabran-traceability": "src/scripts/traceability/validate-traceability.sh",
    "kabran-coverage": "src/scripts/traceability/coverage-report.sh"
  },
  "exports": {
    "./core/config-loader": "./src/core/config-loader.mjs",
    "./eslint": "./src/eslint.mjs",
    "./eslint/node": "./src/eslint-node.mjs",
    "./eslint/react": "./src/eslint-react.mjs",
    "./prettier": "./src/prettier.mjs",
    "./tsconfig/base": "./src/tsconfig.base.json",
    "./tsconfig/node": "./src/tsconfig.node.json",
    "./tsconfig/react": "./src/tsconfig.react.json",
    "./commitlint": "./src/commitlint.mjs",
    "./lint-staged": "./src/lint-staged.mjs",
    "./scripts/license-check": "./src/scripts/license-check.mjs",
    "./scripts/dependency-report": "./src/scripts/dependency-report.mjs",
    "./scripts/readme-validator": "./src/scripts/readme-validator.mjs",
    "./scripts/env-validator": "./src/scripts/env-validator.mjs",
    "./scripts/ci/*": "./src/scripts/ci/*",
    "./scripts/deploy/*": "./src/scripts/deploy/*",
    "./scripts/traceability/*": "./src/scripts/traceability/*",
    "./scripts/setup": "./src/scripts/setup.mjs",
    "./scripts/quality-standard-validator": "./src/scripts/quality-standard-validator.mjs",
    "./scripts/generate-ci-result": "./src/scripts/generate-ci-result.mjs",
    "./scripts/ci-result-utils": "./src/scripts/ci-result-utils.mjs",
    "./scripts/ci-result-history": "./src/scripts/ci-result-history.mjs",
    "./scripts/ci-result-trends": "./src/scripts/ci-result-trends.mjs",
    "./scripts/pr-quality-comment": "./src/scripts/pr-quality-comment.mjs",
    "./schemas/ci-result": "./src/schemas/ci-result.v2.schema.json",
    "./telemetry/config": "./src/telemetry/config/index.mjs",
    "./telemetry/frontend": "./src/telemetry/frontend/index.mjs",
    "./telemetry/edge": "./src/telemetry/edge/index.mjs",
    "./telemetry/node": "./src/telemetry/node/index.mjs",
    "./telemetry/logger": "./src/telemetry/logger/index.mjs",
    "./telemetry/shared": "./src/telemetry/shared/index.mjs"
  },
  "files": [
    "src",
    "templates",
    "CI-CD-MIGRATION.md"
  ],
  "keywords": [
    "eslint",
    "prettier",
    "typescript",
    "commitlint",
    "config",
    "validation",
    "enforcement",
    "ci",
    "cd",
    "deployment",
    "telemetry",
    "opentelemetry",
    "observability",
    "kabran"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabran-owner/kabran-config.git"
  },
  "dependencies": {
    "license-checker": "^25.0.1"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=19.0.0",
    "@commitlint/config-conventional": ">=19.0.0",
    "@eslint/js": ">=9.0.0",
    "eslint": ">=9.0.0",
    "eslint-config-prettier": ">=9.0.0",
    "eslint-plugin-import": ">=2.29.0",
    "eslint-plugin-jsdoc": ">=50.0.0",
    "eslint-plugin-jsx-a11y": ">=6.8.0",
    "eslint-plugin-react-hooks": ">=5.0.0",
    "eslint-plugin-react-refresh": ">=0.4.0",
    "globals": ">=15.0.0",
    "prettier": ">=3.0.0",
    "prettier-plugin-tailwindcss": ">=0.5.0",
    "typescript": ">=5.0.0",
    "typescript-eslint": ">=8.0.0",
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/sdk-trace-web": ">=1.28.0",
    "@opentelemetry/sdk-trace-node": ">=1.28.0",
    "@opentelemetry/sdk-trace-base": ">=1.28.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.56.0",
    "@opentelemetry/resources": ">=1.28.0",
    "@opentelemetry/semantic-conventions": ">=1.28.0",
    "@opentelemetry/core": ">=1.28.0",
    "@opentelemetry/instrumentation": ">=0.56.0",
    "@opentelemetry/instrumentation-fetch": ">=0.56.0",
    "@opentelemetry/instrumentation-document-load": ">=0.43.0",
    "@opentelemetry/instrumentation-user-interaction": ">=0.43.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-jsdoc": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-web": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "@opentelemetry/core": {
      "optional": true
    },
    "@opentelemetry/instrumentation": {
      "optional": true
    },
    "@opentelemetry/instrumentation-fetch": {
      "optional": true
    },
    "@opentelemetry/instrumentation-document-load": {
      "optional": true
    },
    "@opentelemetry/instrumentation-user-interaction": {
      "optional": true
    }
  },
  "scripts": {
    "test": "npm run test:shell && npm run test:node",
    "test:shell": "bats tests/shell/*.bats",
    "test:node": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "bats --formatter tap tests/shell/*.bats && vitest run --reporter=junit"
  },
  "devDependencies": {
    "bats": "^1.11.0",
    "vitest": "^4.0.17"
  }
}
