{
  "name": "@kabran-owner/kabran-config",
  "version": "1.5.2",
  "description": "Shared quality configurations, enforcement scripts, and CI/CD tooling for Kabran projects",
  "author": "Kabran",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./eslint": "./src/eslint.mjs",
    "./eslint/node": "./src/eslint-node.mjs",
    "./eslint/react": "./src/eslint-react.mjs",
    "./prettier": "./src/prettier.mjs",
    "./tsconfig/base": "./src/tsconfig.base.json",
    "./tsconfig/node": "./src/tsconfig.node.json",
    "./tsconfig/react": "./src/tsconfig.react.json",
    "./commitlint": "./src/commitlint.mjs",
    "./lint-staged": "./src/lint-staged.mjs",
    "./scripts/license-check": "./src/scripts/license-check.mjs",
    "./scripts/dependency-report": "./src/scripts/dependency-report.mjs",
    "./scripts/readme-validator": "./src/scripts/readme-validator.mjs",
    "./scripts/env-validator": "./src/scripts/env-validator.mjs",
    "./scripts/ci/*": "./src/scripts/ci/*",
    "./scripts/deploy/*": "./src/scripts/deploy/*"
  },
  "files": [
    "src",
    "CI-CD-MIGRATION.md"
  ],
  "keywords": [
    "eslint",
    "prettier",
    "typescript",
    "commitlint",
    "config",
    "validation",
    "enforcement",
    "ci",
    "cd",
    "deployment",
    "kabran"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kabran-owner/kabran-config"
  },
  "dependencies": {
    "license-checker": "^25.0.1"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=19.0.0",
    "@commitlint/config-conventional": ">=19.0.0",
    "@eslint/js": ">=9.0.0",
    "eslint": ">=9.0.0",
    "eslint-config-prettier": ">=9.0.0",
    "eslint-plugin-import": ">=2.29.0",
    "eslint-plugin-jsdoc": ">=50.0.0",
    "eslint-plugin-jsx-a11y": ">=6.8.0",
    "eslint-plugin-react-hooks": ">=5.0.0",
    "eslint-plugin-react-refresh": ">=0.4.0",
    "globals": ">=15.0.0",
    "prettier": ">=3.0.0",
    "prettier-plugin-tailwindcss": ">=0.5.0",
    "typescript": ">=5.0.0",
    "typescript-eslint": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-jsdoc": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  },
  "scripts": {
    "test": "bats tests/*.bats",
    "test:ci": "bats --formatter tap tests/*.bats",
    "test:watch": "watch -n 2 bats tests/*.bats"
  },
  "devDependencies": {
    "bats": "^1.11.0"
  }
}
